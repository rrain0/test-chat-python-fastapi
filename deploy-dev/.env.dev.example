
# Create .env.dev file from this example

FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Postgres connection url. Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
POSTGRES_URL=postgresql://backend_db_user:backend_db_user_pwd@localhost:5432/test_chat_python_fastapi_db

# Redis connection url. Format: redis://<user>:<password>@<host>:<port>/<database_index>
REDIS_URL=redis://backend_cache_user:backend_cache_user_pwd@127.0.0.1:6379/0
REDIS_PREFIX=test-chat

WEB_ACCESS_TOKEN_SECRET=563d89ce-4cfc-4f31-90fd-aa9f1a7cf1de
# Duration string. Format: 2y3M1.5w2d3.5h4m5s600ms
WEB_ACCESS_TOKEN_LIFETIME=30m

WEB_REFRESH_TOKEN_SECRET=22067aa8-d236-45f3-a8e8-56fe94ea1c5f
WEB_REFRESH_TOKEN_LIFETIME=30d
WEB_REFRESH_TOKEN_GRACE_PERIOD=1m

TG_BOT_ACCESS_TOKEN_SECRET=f75df0f0-bb84-4bee-b579-5539e481328e
TG_BOT_ACCESS_TOKEN_LIFETIME=1m
